[Unit]
Description=MQTT Call headless voice listener
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mqtt-call/linux
ExecStart=/opt/mqtt-call/linux/c/mqtt-call-listener /etc/mqtt-call/listener.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
